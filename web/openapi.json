        "enum": [
          "Postgres",
          "Index",
          "Webhook"
        ]
      },
      "SinkResponse": {
        "required": [
          "id",
          "kind",
          "tables",
          "target",
          "state",
          "blockedRows",
          "sources",
          "counters"
