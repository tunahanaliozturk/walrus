          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SinkSourceResponse"
            }
          },
          "counters": {
            "$ref": "#/components/schemas/SinkCountersResponse"
          }
        }
      },
      "SinkSourceResponse": {
        "required": [
          "source",
          "appliedSeq",
          "headSeq",
          "startLsn",
          "pendingLsn",
          "lagMilliseconds"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "appliedSeq": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "headSeq": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "startLsn": {
            "type": "string"
          },
          "pendingLsn": {
            "type": [
              "null",
              "string"
            ]
          },
          "lagMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "SinkStartMode": {
        "enum": [
          "Beginning",
          "Now",
          "Lsn",
          "Snapshot"
        ]
      },
      "SinkState": {
        "enum": [
          "Running",
          "Retrying",
          "Rebuilding",
          "Stopped"
        ]
      },
      "SourceResponse": {
        "required": [
          "name",
          "attachedTo",
          "primary",
          "walRetainedBytes",
          "confirmedFlushLsn",
          "slotActive",
          "standbys",
          "changes",
          "transactions",
          "resent",
          "lastCommit",
          "lastError",
          "checkedAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "attachedTo": {
            "type": [
              "null",
              "string"
            ]
          },
          "primary": {
            "type": [
              "null",
              "string"
            ]
          },
          "walRetainedBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "confirmedFlushLsn": {
            "type": [
              "null",
              "string"
            ]
          },
          "slotActive": {
            "type": "boolean"
          },
          "standbys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandbyResponse"
            }
          },
          "changes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "transactions": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "resent": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "lastCommit": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          },
          "checkedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SseItemOfFeedEntry": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FeedEntry"
          },
          "eventType": {
            "type": [
              "null",
              "string"
            ]
          },
          "eventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reconnectionInterval": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StandbyResponse": {
        "required": [
          "host",
          "synced",
          "confirmedFlushLsn"
        ],
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "synced": {
            "type": "boolean"
          },
          "confirmedFlushLsn": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StatsResponse": {
        "required": [
          "at",
          "sources",
          "sinks"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            }
          },
          "sinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SinkResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Walrus.Api"
    },
    {
      "name": "Endpoints"
    }
  ]
