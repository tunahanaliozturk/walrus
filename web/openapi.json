            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "commitLsn": {
            "type": "string"
          },
          "sink": {
            "type": [
              "null",
              "string"
            ]
          },
