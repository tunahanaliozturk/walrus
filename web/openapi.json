        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "key": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnValue"
            }
          },
          "row": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnValue"
            }
          }
        }
