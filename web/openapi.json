              "null",
              "string"
            ]
          },
          "start": {
            "$ref": "#/components/schemas/SinkStartMode"
          },
          "startLsn": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RetryResponse": {
        "required": [
