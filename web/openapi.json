          "id",
          "source",
          "seq",
          "table",
          "operation",
          "key",
          "error",
          "attempts",
          "deadAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "seq": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "table": {
            "type": "string"
          },
          "operation": {
